# ArtGrid Backend — .gitignore
.env
*.env.local
*.env.production

# Go build artefacts
artgrid-auth-service/artgrid-auth
artgrid-ai-proxy/artgrid-proxy

# Python
artgrid-ml-service/__pycache__/
artgrid-ml-service/**/__pycache__/
artgrid-ml-service/*.pyc
artgrid-ml-service/.venv/

# Model weights live under models/ — commit with Git LFS (see repo root `.gitattributes`).
# Ignore incomplete downloads and OS junk (actual weights like .onnx / .dat are tracked):
models/*.part
models/**/*.part
models/*.tmp
models/**/*.tmp
models/.DS_Store
models/**/.DS_Store
models/Thumbs.db
models/**/Thumbs.db

# Docker volumes
pg_data/

# Local Cloud SQL Auth Proxy binary (download from Google; do not commit)
cloud-sql-proxy.exe

# IDE
.idea/
.vscode/
*.swp
